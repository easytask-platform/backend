<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Human-readable console output; request_id/user_id come from the MDC
         (set by HttpLoggingFilter / JwtAuthenticationFilter). -->
    <property name="CONSOLE_PATTERN"
              value="%d{HH:mm:ss.SSS} %-5level [%X{request_id:-startup}] %logger{30} - %msg%n"/>

    <springProfile name="!prod">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>${CONSOLE_PATTERN}</pattern>
            </encoder>
        </appender>
    </springProfile>

    <!-- prod: same pattern with full timestamps. Swap the encoder for
         net.logstash.logback LogstashEncoder (Regardian pattern) if a JSON
         log pipeline is ever needed — requires the logstash-logback-encoder
         dependency. -->
    <springProfile name="prod">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%X{request_id:-startup}] %logger{36} - %msg%n</pattern>
            </encoder>
        </appender>
    </springProfile>

    <!-- Security audit events always at INFO regardless of root level. -->
    <logger name="SECURITY_AUDIT" level="INFO"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
